# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-xxx

# OpenAI API Key (for voice memo transcription via Whisper)
OPENAI_API_KEY=sk-xxx

# Linq API
LINQ_API_TOKEN=your_linq_bearer_token
LINQ_API_BASE_URL=https://api.linqapp.com/api/partner/v3

# Server
PORT=3000

# Linq phone numbers this bot runs on (comma-separated, supports multiple)
LINQ_AGENT_BOT_NUMBERS=+14155551234

# RCS: attach a saveable contact.vcf using this number's active Linq contact
# profile (name, phone, embedded photo). Set false to disable. iMessage keeps
# native name/photo sharing. VCF is sent once per chat per process.
RCS_CONTACT_CARD_ENABLED=true

# Sender phone numbers to ignore (comma-separated) - you'll respond to these manually
IGNORED_SENDERS=+14155555678,+14155559999

# Only respond to these sender numbers (comma-separated) - useful for local dev to avoid double-replies
# Leave empty/unset to respond to everyone
ALLOWED_SENDERS=

# DynamoDB table name for conversation storage (defaults to linq-blue-agent-example)
DYNAMODB_TABLE_NAME=linq-blue-agent-example

# Claude model for main replies (default: claude-haiku-4-5). Group-chat filtering stays on Haiku.
# Use claude-sonnet-4-6 if you want higher quality and can afford it.
CLAUDE_MODEL=claude-haiku-4-5

# Usage limits (0 disables that cap). Daily counters reset at midnight in USAGE_TIMEZONE.
# The per-chat cap is the group-chat backstop: a whole group shares one budget.
DAILY_MESSAGE_LIMIT_PER_SENDER=25
DAILY_MESSAGE_LIMIT_PER_CHAT=50
DAILY_MESSAGE_LIMIT_GLOBAL=500
DAILY_IMAGE_LIMIT_PER_SENDER=3
DAILY_IMAGE_LIMIT_GLOBAL=30
RATE_LIMIT_MESSAGES=8
RATE_LIMIT_WINDOW_SECONDS=600
USAGE_TIMEZONE=America/Los_Angeles

# Phone numbers that skip all usage limits (comma-separated)
UNLIMITED_SENDERS=
